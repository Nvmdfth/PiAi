root ::= "{" ws action-pair "," ws target-pair "," ws params-pair "," ws conf-pair "}" ws

action-pair ::= "\"action\"" ws ":" ws action-type
target-pair ::= "\"target\"" ws ":" ws string
params-pair ::= "\"parameters\"" ws ":" ws object
conf-pair   ::= "\"confidence\"" ws ":" ws number

action-type ::= "\"read\"" | "\"write\"" | "\"restart\"" | "\"alert\"" | "\"status\""

object ::= "{" ws ( string ":" ws value ("," ws string ":" ws value)* )? "}" ws
array  ::= "[" ws ( value ("," ws value)* )? "]" ws
value  ::= object | array | string | number | ("true" | "false" | "null") ws

string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}) )* "\"" ws
number ::= ("-"? ([0-9] | [1-9] [0-9]{0,15})) ("." [0-9]+)? ws
ws     ::= | " " | "\n" [ \t]{0,20}
